# ================================================================
# antd-flutter .gitignore
# Flutter 组件库 monorepo (lib + test + example)
# ================================================================

# ---- 工作区辅助目录（非项目代码，不纳入版本控制）----
# ai-brain 内嵌独立 git 仓库，需无斜杠模式才能匹配 gitlink
ai-brain
.agents/
.joycode/
.temp/
AGENTS.md

# ---- 操作系统 ----
.DS_Store
Thumbs.db

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.iml
*.ipr
*.iws

# ---- Flutter / Dart / Pub ----
# 根包为库(library)，不提交 pubspec.lock（example 应用自身的 lock 不受影响）
/pubspec.lock
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
**/doc/api/
packages/*/doc/
/doc/api/
generated_plugin_registrant.dart

# ---- 测试 / 覆盖率 ----
coverage/
lcov.info

# ---- 鸿蒙 OHOS 产物（ohos 构建暂缓，待就绪后启用）----
*.hap
*.hsp
oh_modules/

# ---- 日志 ----
*.log

# ---- FVM（Flutter 版本管理，如使用）----
.fvm/